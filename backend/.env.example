# Copy to .env and adjust for your environment
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Local dev default. In production, use Neon (or any free-tier Postgres) instead --
# SQLite's file doesn't survive redeploys on most free hosts.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./grahika.db
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200
